
#include <stdio.h>

int max(int a, int b)
{
    return (a > b) ? a : b;
}

int main()
{
    int n, W, i, w;
    int wt[20], val[20];
    int dp[20][100];

    printf("Enter number of items: ");
    scanf("%d", &n);

    printf("Enter weights of items:\n");
    for(i = 1; i <= n; i++)
        scanf("%d", &wt[i]);

    printf("Enter values of items:\n");
    for(i = 1; i <= n; i++)
        scanf("%d", &val[i]);

    printf("Enter knapsack capacity: ");
    scanf("%d", &W);

    for(i = 0; i <= n; i++)
    {
        for(w = 0; w <= W; w++)
        {
            if(i == 0 || w == 0)
                dp[i][w] = 0;

            else if(wt[i] <= w)
                dp[i][w] = max(val[i] + dp[i-1][w-wt[i]],
                               dp[i-1][w]);

            else
                dp[i][w] = dp[i-1][w];
        }
    }

    printf("Maximum profit = %d", dp[n][W]);

    return 0;
}
