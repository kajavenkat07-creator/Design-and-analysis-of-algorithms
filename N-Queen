
#include <stdio.h>

int board[20][20];
int n, count = 0;

int isSafe(int row, int col)
{
    int i, j;

    for(i = 0; i < row; i++)
        if(board[i][col] == 1)
            return 0;

    for(i = row - 1, j = col - 1; i >= 0 && j >= 0; i--, j--)
        if(board[i][j] == 1)
            return 0;

    for(i = row - 1, j = col + 1; i >= 0 && j < n; i--, j++)
        if(board[i][j] == 1)
            return 0;

    return 1;
}

void solveNQueen(int row)
{
    int col, i, j;

    if(row == n)
    {
        count++;

        printf("\nSolution %d:\n", count);

        for(i = 0; i < n; i++)
        {
            for(j = 0; j < n; j++)
                printf("%d ", board[i][j]);

            printf("\n");
        }

        return;
    }

    for(col = 0; col < n; col++)
    {
        if(isSafe(row, col))
        {
            board[row][col] = 1;

            solveNQueen(row + 1);

            board[row][col] = 0;
        }
    }
}

int main()
{
    printf("Enter the number of queens: ");
    scanf("%d", &n);

    if(n < 1 || n > 20)
    {
        printf("Invalid input");
        return 0;
    }

    solveNQueen(0);

    if(count == 0)
        printf("No solution exists");
    else
        printf("\nTotal solutions = %d", count);

    return 0;
}
